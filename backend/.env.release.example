APP_ENV=production
HOST=0.0.0.0
PORT=3000

# 发布包内的运行路径（相对发布目录）
DB_PATH=data/app.db
# 可选磁盘前端目录；若不存在会回退到内嵌前端资源
STATIC_DIR=frontend/dist
ASSETS_DIR=data/gamelist

# 游戏库根目录
PRIMARY_ROM_ROOT=ROM

# SMB / VHD 启动脚本配置
# 单共享场景示例：\\192.168.1.4\Game1
SMB_SHARE_ROOT=
# 多挂载点场景示例：
# SMB_PATH_MAPPINGS=/mnt/Mount/Game/Game=\\\\192.168.1.4\\Game1;/mnt/Mount/Game/Gal=\\\\192.168.1.4\\Gal
SMB_PATH_MAPPINGS=
SMB_USERNAME=
SMB_PASSWORD=
VHD_DIFF_ROOT=C:

# 管理员认证
# 生产环境启动前必须填写，留空会拒绝启动
ADMIN_DISPLAY_NAME=Admin
ADMIN_PASSWORD=
AUTH_MAX_FAILS=5
AUTH_COOLDOWN=10m
AUTH_FAIL_WINDOW=30m
AUTH_STATE_TTL=24h
AUTH_TRACK_BY=ip_ua
WIKI_HISTORY_LIMIT=100

# 可选代理
PROXY=

READ_HEADER_TIMEOUT=5s
SHUTDOWN_TIMEOUT=10s

# ============================================================
# GameAtlas 后端配置
# ============================================================
# 复制本文件为 .env 并按需修改。
# 后端启动时自动加载运行目录下的 .env；不存在则跳过。
# 所有路径配置支持相对路径（相对于 .env 所在目录）和绝对路径。

# --- 运行环境 ---
# development: Gin 调试模式（详细请求日志）
# production:  Gin 线上模式（精简日志，性能更好）
APP_ENV=development

# --- 监听地址 ---
HOST=0.0.0.0
PORT=3000

# --- 核心路径 ---
# SQLite 数据库文件路径
DB_PATH=data/db.db
# 磁盘前端资源目录；不存在时自动回退到编译内嵌的前端资源。
# 开发时指向 frontend/dist，发布包里一般不需要改。
STATIC_DIR=../frontend/dist
# 游戏素材根目录（封面、截图、视频等文件存放位置）
ASSETS_DIR=data/gamelist
# 游戏文件根目录（ROM / VHD / VHDX 等）
PRIMARY_ROM_ROOT=ROM

# --- 管理员认证 ---
# 管理员登录密码，必须填写，否则服务拒绝启动
ADMIN_PASSWORD=
# 管理员显示名称（页面展示用）
ADMIN_DISPLAY_NAME=Admin
# 登录失败次数限制
AUTH_MAX_FAILS=5
# 触发限制后的冷却时间
AUTH_COOLDOWN=10m
# 失败计数的时间窗口
AUTH_FAIL_WINDOW=30m
# 登录会话有效期
AUTH_STATE_TTL=24h
# 失败追踪方式：ip（按 IP）| ip_ua（按 IP + User-Agent）
AUTH_TRACK_BY=ip_ua
# Wiki 历史版本保留数量
WIKI_HISTORY_LIMIT=100

# --- SMB / VHD 远程启动 ---
# 单 SMB 共享根路径（UNC 格式）
SMB_SHARE_ROOT=
# 多挂载点映射（本地路径=UNC路径，分号分隔）
# 示例：/mnt/Game=\\192.168.1.4\Game1;/mnt/Gal=\\192.168.1.4\Gal
SMB_PATH_MAPPINGS=
SMB_USERNAME=
SMB_PASSWORD=
# 客户端差分盘存放的盘符
VHD_DIFF_ROOT=C:

# --- 可选功能 ---
# 出站代理（http / https / socks5），留空则直连
PROXY=
# SteamGridDB API Key，用于封面/横幅/Logo 在线素材搜索
# 注册获取：https://www.steamgriddb.com/account
STEAMGRIDDB_API_KEY=

# --- HTTP 服务器调优 ---
READ_HEADER_TIMEOUT=5s
SHUTDOWN_TIMEOUT=10s

APP_ENV=development
HOST=0.0.0.0
PORT=3000

# 核心路径
DB_PATH=data/db.db
# 磁盘前端目录不存在时，会自动回退到内嵌前端资源。
STATIC_DIR=../frontend/dist
ASSETS_DIR=data/gamelist

# 游戏库根目录
PRIMARY_ROM_ROOT=ROM

# SMB / VHD 启动脚本配置
SMB_SHARE_ROOT=\\192.168.1.4\Game
# 多挂载点映射示例：
# SMB_PATH_MAPPINGS=/mnt/Mount/Game/Game=\\\\192.168.1.4\\Game1;/mnt/Mount/Game/Gal=\\\\192.168.1.4\\Gal
SMB_PATH_MAPPINGS=
SMB_USERNAME=
SMB_PASSWORD=
VHD_DIFF_ROOT=C:

# 管理员认证
ADMIN_DISPLAY_NAME=Admin
ADMIN_PASSWORD=
AUTH_MAX_FAILS=5
AUTH_COOLDOWN=10m
AUTH_FAIL_WINDOW=30m
AUTH_STATE_TTL=24h
AUTH_TRACK_BY=ip_ua
WIKI_HISTORY_LIMIT=100

# 可选代理
PROXY=

# SteamGridDB（可选，封面/横幅/Logo 在线素材搜索）
# 注册：https://www.steamgriddb.com/account
STEAMGRIDDB_API_KEY=

LOG_LEVEL=info
READ_HEADER_TIMEOUT=5s
SHUTDOWN_TIMEOUT=10s

# GameAtlas 配置（首次启动自动生成）
# 修改后重启服务生效

# 运行环境：development / production
APP_ENV=production

# 监听地址
HOST=0.0.0.0
PORT=3000

# 数据库路径
DB_PATH=data/db.db
# 游戏素材目录（封面、截图等）
ASSETS_DIR=data/gamelist
# 游戏文件根目录（ROM / VHD）
PRIMARY_ROM_ROOT=/mnt

# 管理员密码（必须修改！）
ADMIN_PASSWORD=1234
# 管理员显示名称
ADMIN_DISPLAY_NAME=Admin
# 登录失败限制
AUTH_MAX_FAILS=5
AUTH_COOLDOWN=10m
AUTH_FAIL_WINDOW=30m
AUTH_STATE_TTL=24h
AUTH_TRACK_BY=ip_ua
# Wiki 历史保留数量
WIKI_HISTORY_LIMIT=100

# SMB 远程启动配置
# 路径映射：本地路径=UNC路径，分号分隔
SMB_PATH_MAPPINGS=
SMB_USERNAME=
SMB_PASSWORD=
VHD_DIFF_ROOT=C:

# 出站代理（留空直连）
PROXY=
# SteamGridDB API Key（可选）
STEAMGRIDDB_API_KEY=

# HTTP 调优
READ_HEADER_TIMEOUT=5s
SHUTDOWN_TIMEOUT=10s
